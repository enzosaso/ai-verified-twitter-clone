# Copy this file to `.env` for local development. Do not commit `.env`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twitter_clone"

# Optional. Database integration tests use TEST_DATABASE_URL when set,
# otherwise DATABASE_URL. Both must look local/test (localhost, 127.0.0.1,
# twitter_clone, or _test). Tests never reset a remote database.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twitter_clone"
