# Build context hygiene: keep host artifacts, secrets and local junk out of the image.
.git
.gitignore
node_modules
.next
out
build

# Prisma client is generated inside the image for the container's platform.
src/generated

# secrets and local env
.env
.env*.local

# test and coverage output
coverage
test-results
playwright-report
blob-report
playwright/.cache

# not needed at runtime
docs
e2e
*.tsbuildinfo
.DS_Store
.vercel
Dockerfile
docker-compose.yml
